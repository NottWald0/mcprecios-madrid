# Copia este archivo como .env y rellena tus valores reales.
# En Render/Railway, estas mismas claves se configuran como variables de entorno
# del servicio, no como archivo .env.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=comparador_de_precios
# true para bases de datos en la nube que exigen conexión cifrada (TiDB Cloud)
DB_SSL=false

# Opcional: el hosting suele asignarlo solo, no hace falta tocarlo
# PORT=5000
