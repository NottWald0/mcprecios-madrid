# Copia este archivo como .env para desarrollo local del scraper/db_loader.
# En GitHub Actions, estas mismas claves se configuran como "Secrets" del
# repositorio (Settings > Secrets and variables > Actions), no como archivo .env.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=comparador_de_precios

# false en tu PC (para ver el navegador), true en GitHub Actions
HEADLESS=false
